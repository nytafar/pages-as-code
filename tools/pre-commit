#!/usr/bin/env php
<?php
/**
 * Kaupang suite pre-commit hook: one version, synced everywhere. (kit v2, docs/kit/)
 *
 * The plugin header `Version:` in <repo-folder>.php is the single source of truth. On every commit:
 *   1. syncs it into the *_VERSION constant, readme.txt `Stable tag:`, readme.meta.json `stableTag`,
 *      package.json `version` and any tracked block.json that has a `version` key;
 *   2. regenerates readme.txt from header + README.md + CHANGELOG.md (tools/generate-readme.php) — readme.txt is an artefact;
 *   3. refuses a version bump without a `## [x.y.z]` section in CHANGELOG.md (Keep a Changelog);
 *   4. runs tools/pre-commit-check if present and executable (plugin-local checks, e.g. build --check — note: those see
 *      the working tree, not the index, so keep generated files staged together with their sources).
 *
 * Install (per checkout, as the site user):  git config core.hooksPath tools
 * Copied, not shared: keep every plugin's tools/pre-commit identical to docs/kit/pre-commit.
 */

function git( string $args, ?int &$code = null ): string {
	exec( 'git ' . $args . ' 2>/dev/null', $out, $code );
	return implode( "\n", $out );
}
/** Exact staged content of a tracked file, or null when it isn't in the index. */
function staged( string $file ): ?string {
	git( 'ls-files --error-unmatch -- ' . escapeshellarg( $file ), $code );
	return 0 === $code ? (string) shell_exec( 'git show :' . escapeshellarg( $file ) ) : null;
}
function fail( string $msg ): void {
	fwrite( STDERR, "pre-commit: {$msg}\n" );
	exit( 1 );
}

$root = git( 'rev-parse --show-toplevel' );
chdir( $root );
$main = git( 'config kit.main' ) ?: basename( $root ) . '.php'; // override for clones/worktrees not named after the plugin

if ( ! is_file( $main ) ) {
	fwrite( STDERR, "pre-commit: WARNING — {$main} not found, so NOTHING was synced. If this checkout's folder isn't named after\n" .
		"the plugin, run: git config kit.main <plugin-folder>.php\n" );
	exit( 0 );
}

$version_re = '/^[ \t\/*#@]*Version:[ \t]*(\S+)/mi';
if ( ! preg_match( $version_re, (string) staged( $main ), $m ) ) {
	fail( "no 'Version:' header in {$main}." );
}
$version = $m[1];
if ( ! preg_match( '/^\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?$/', $version ) ) {
	fail( "header Version '{$version}' is not semver (x.y.z)." );
}

// file => [ regex, replacement ] — only rewritten when the file exists and the value differs.
$targets = array(
	$main              => array( "/(define\(\s*'[A-Z0-9_]+_VERSION'\s*,\s*')[^']*('\s*\))|(const\s+[A-Z0-9_]+_VERSION\s*=\s*')[^']*(')/", null ),
	'readme.txt'       => array( '/^(Stable tag:[ \t]*).*$/mi', '${1}' . $version ),
	'readme.meta.json' => array( '/("stableTag"\s*:\s*")[^"]*(")/', '${1}' . $version . '${2}' ),
	'package.json'     => array( '/("version"\s*:\s*")[^"]*(")/', '${1}' . $version . '${2}' ),
);
foreach ( array_filter( explode( "\n", git( "ls-files -- ':(glob)**/block.json'" ) ) ) as $bj ) { // exactly block.json, any depth
	$targets[ $bj ] = array( '/("version"\s*:\s*")[^"]*(")/', '${1}' . $version . '${2}' );
}

// Validate everything before writing anything, so a refused commit leaves the tree untouched.

// A bump (header differs from HEAD, or the file is new) needs its changelog section.
$head = git( 'show HEAD:' . escapeshellarg( $main ), $code );
$prev = ( 0 === $code && preg_match( $version_re, $head, $h ) ) ? $h[1] : null;
if ( $prev !== $version ) {
	if ( ! preg_match( '/^##\s*\[' . preg_quote( $version, '/' ) . '\]/m', (string) staged( 'CHANGELOG.md' ) ) ) {
		fail( "version " . ( $prev ?? '(new)' ) . " → {$version} but the staged CHANGELOG.md has no '## [{$version}]' section." );
	}
}

// Sync the *staged* content (that's what gets committed); the working tree must match it for files we touch.
$targets['package-lock.json'] = array( null, function ( string $src ) use ( $version ): string {
	$j = json_decode( $src, true );
	if ( ! is_array( $j ) ) {
		return $src;
	}
	$j['version'] = $version;
	if ( isset( $j['packages'][''] ) ) {
		$j['packages']['']['version'] = $version;
	}
	$out = json_encode( $j, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE ) . "\n";
	return preg_replace_callback( '/^( {4})+/m', fn( $x ) => str_repeat( '  ', strlen( $x[0] ) / 4 ), $out ); // npm indents with 2
} );

$writes = array();
foreach ( $targets as $file => list( $re, $rep ) ) {
	$src = staged( $file );
	if ( null === $src ) {
		continue; // not tracked
	}
	if ( $rep instanceof Closure ) {
		$new = ( json_decode( $src, true )['version'] ?? null ) === $version ? $src : $rep( $src );
	} elseif ( null === $rep ) {
		$new = preg_replace_callback( $re, fn( $x ) => '' !== $x[1] ? $x[1] . $version . $x[2] : $x[3] . $version . $x[4], $src, 1 );
	} else {
		$new = preg_replace( $re, $rep, $src, 1 );
	}
	if ( $new === $src ) {
		continue;
	}
	git( 'diff --quiet -- ' . escapeshellarg( $file ), $dirty );
	if ( 0 !== $dirty ) {
		fail( "{$file} needs a version sync but has unstaged changes; stage or stash them first." );
	}
	$writes[ $file ] = $new;
}

if ( is_file( 'tools/generate-readme.php' ) && null !== staged( 'readme.txt' ) ) {
	git( 'diff --quiet -- readme.txt', $dirty );
	if ( 0 !== $dirty ) {
		fail( 'readme.txt is generated from the header + README.md + CHANGELOG.md; discard your edits to it (git checkout -- readme.txt).' );
	}
}

if ( is_file( 'tools/pre-commit-check' ) && is_executable( 'tools/pre-commit-check' ) ) {
	passthru( './tools/pre-commit-check', $code );
	if ( 0 !== $code ) {
		fail( 'tools/pre-commit-check failed.' );
	}
}

foreach ( $writes as $file => $new ) {
	file_put_contents( $file, $new );
	git( 'add -- ' . escapeshellarg( $file ) );
}

if ( is_file( 'tools/generate-readme.php' ) ) {
	passthru( 'php tools/generate-readme.php --index', $code ); // from staged content, so readme.txt matches the commit
	if ( 0 !== $code ) {
		fail( 'tools/generate-readme.php failed.' );
	}
	git( 'add -- readme.txt' );
}
exit( 0 );
